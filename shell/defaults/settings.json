{
  "theme": {
    "palette": "monochrome"
  },
  "font": {
    "family": "JetBrainsMono Nerd Font",
    "size": 13
  },
  "ui": {
    "scale": 1.0
  },
  "anim": {
    "enabled": true
  },
  "wallpaper": {
    "path": "",
    "dir": "~/Pictures/Wallpapers"
  },
  "apps": {
    "terminal": "kitty"
  },
  "theming": {
    "kitty": true,
    "gtk": true,
    "vscode": true,
    "spicetify": true,
    "sddm": true,
    "matugen": true
  },
  "stats": {
    "interval": 2000
  },
  "notify": {
    "timeout": 5,
    "max": 4
  },
  "lock": {
    "service": "login"
  },
  "idle": {
    "lock": 300,
    "screenOff": 600
  },
  "bar": {
    "height": 34,
    "gap": 8,
    "radius": 10,
    "borderWidth": 1
  }
}
