pkgbase = vibeshell-git
	pkgdesc = A terminal-flavoured desktop shell for niri, built on Quickshell
	pkgver = r0.0.0
	pkgrel = 1
	url = https://github.com/funnitzee/VibeShell
	arch = any
	license = MIT
	makedepends = git
	depends = bluez
	depends = networkmanager
	depends = niri
	depends = pipewire
	depends = quickshell
	depends = upower
	depends = wireplumber
	optdepends = brightnessctl: brightness control
	optdepends = cliphist: clipboard history
	optdepends = gammastep: night light
	optdepends = grim: screenshots
	optdepends = libnotify: shell notifications
	optdepends = matugen: colour sync from the accent
	optdepends = power-profiles-daemon: power profiles
	optdepends = slurp: region screenshots
	optdepends = swappy: annotate screenshots
	optdepends = swaybg: wallpapers
	optdepends = ttf-jetbrains-mono-nerd: default shell font
	optdepends = wl-clipboard: clipboard and copying shots
	provides = vibeshell
	conflicts = vibeshell
	source = vibeshell-git::git+https://github.com/funnitzee/VibeShell.git
	sha256sums = SKIP

pkgname = vibeshell-git
