/**********************************************************************
* VibeShell SDDM theme.
*
* Terminal-styled login screen matching the VibeShell palette. Every colour
* comes from theme.conf (generated by the shell/installer), so the login
* screen follows the active palette without touching this file.
**********************************************************************/

import QtQuick 2.0
import SddmComponents 2.0

Rectangle {
    id: container

    width: 800
    height: 500
    color: config.bg

    LayoutMirroring.enabled: Qt.locale().textDirection == Qt.RightToLeft
    LayoutMirroring.childrenInherit: true

    property int sessionIndex: session.index
    property string mono: config.font

    TextConstants {
        id: textConstants
    }

    Connections {
        target: sddm

        function onLoginSucceeded() {
            message.color = config.dim;
            message.text = textConstants.loginSucceeded;
        }
        function onLoginFailed() {
            password.text = "";
            message.color = config.urgent;
            message.text = textConstants.loginFailed;
        }
        function onInformationMessage(msg) {
            message.color = config.urgent;
            message.text = msg;
        }
    }

    // TUI frame: thin border lines with the title cut into the top one.
    Rectangle {
        id: frame

        anchors.centerIn: parent
        width: mainColumn.width + 96
        height: mainColumn.height + 96
        color: config.bg
        border.width: 0

        Rectangle {
            anchors.top: parent.top
            width: parent.width
            height: 1
            color: config.border
        }
        Rectangle {
            anchors.bottom: parent.bottom
            width: parent.width
            height: 1
            color: config.border
        }
        Rectangle {
            anchors.left: parent.left
            height: parent.height
            width: 1
            color: config.border
        }
        Rectangle {
            anchors.right: parent.right
            height: parent.height
            width: 1
            color: config.border
        }

        // Title patch that interrupts the top border.
        Rectangle {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            width: titleText.width + 24
            height: titleText.height
            color: config.bg

            Text {
                id: titleText
                anchors.centerIn: parent
                text: " vibeshell "
                color: config.fg
                font.family: container.mono
                font.pixelSize: 14
            }
        }
    }

    Column {
        id: mainColumn

        anchors.centerIn: parent
        spacing: 12

        Text {
            anchors.horizontalCenter: parent.horizontalCenter
            color: config.dim
            font.family: container.mono
            font.pixelSize: 12
            text: textConstants.welcomeText.arg(sddm.hostName)
        }

        Item {
            width: 1
            height: 4
        }

        Row {
            spacing: 10

            Text {
                width: 100
                anchors.verticalCenter: parent.verticalCenter
                color: config.dim
                font.family: container.mono
                font.pixelSize: 13
                text: textConstants.userName
            }

            TextBox {
                id: name

                width: 320
                height: 30
                text: userModel.lastUser
                color: config.bg
                textColor: config.fg
                borderColor: config.border
                focusColor: config.accent
                font.family: container.mono
                font.pixelSize: 13

                KeyNavigation.tab: password

                Keys.onPressed: function (event) {
                    if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                        sddm.login(name.text, password.text, sessionIndex);
                        event.accepted = true;
                    }
                }
            }
        }

        Row {
            spacing: 10

            Text {
                width: 100
                anchors.verticalCenter: parent.verticalCenter
                color: config.dim
                font.family: container.mono
                font.pixelSize: 13
                text: textConstants.password
            }

            PasswordBox {
                id: password

                width: 320
                height: 30
                color: config.bg
                textColor: config.fg
                borderColor: config.border
                focusColor: config.accent
                font.family: container.mono
                font.pixelSize: 13

                KeyNavigation.tab: session

                Keys.onPressed: function (event) {
                    if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                        sddm.login(name.text, password.text, sessionIndex);
                        event.accepted = true;
                    }
                }
            }
        }

        Row {
            spacing: 10

            Text {
                width: 100
                anchors.verticalCenter: parent.verticalCenter
                color: config.dim
                font.family: container.mono
                font.pixelSize: 13
                text: textConstants.session
            }

            ComboBox {
                id: session

                width: 320
                height: 30
                color: config.bg
                textColor: config.fg
                menuColor: config.bg
                borderColor: config.border
                focusColor: config.accent
                font.family: container.mono
                font.pixelSize: 13

                model: sessionModel
                index: sessionModel.lastIndex
            }
        }

        Text {
            id: message

            anchors.horizontalCenter: parent.horizontalCenter
            width: 420
            height: 18
            horizontalAlignment: Text.AlignHCenter
            color: config.urgent
            font.family: container.mono
            font.pixelSize: 12
        }

        Row {
            anchors.horizontalCenter: parent.horizontalCenter
            spacing: 18

            Text {
                id: loginButton
                color: config.accent
                font.family: container.mono
                font.pixelSize: 13
                text: "[ login ]"

                KeyNavigation.tab: rebootButton

                MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    onClicked: sddm.login(name.text, password.text, sessionIndex)
                }
            }

            Text {
                id: rebootButton
                color: config.dim
                font.family: container.mono
                font.pixelSize: 13
                text: "[ reboot ]"

                KeyNavigation.tab: shutdownButton

                MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    onClicked: sddm.reboot()
                }
            }

            Text {
                id: shutdownButton
                color: config.dim
                font.family: container.mono
                font.pixelSize: 13
                text: "[ poweroff ]"

                KeyNavigation.tab: name

                MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    onClicked: sddm.powerOff()
                }
            }
        }
    }

    Component.onCompleted: {
        if (name.text === "")
            name.focus = true;
        else
            password.focus = true;
    }
}
